// Usage: npx tsx scripts/check-resume-examples.mts [roleSlug ...]
// Validates the Resume Examples data files and regenerates the import index.
import { readdirSync, readFileSync, writeFileSync } from "node:fs";
import path from "node:path";
import { checkAll, checkSample, duplicateIssues } from "../src/lib/resume-examples/checks.ts";
import type { Sample } from "../src/lib/resume-examples/types.ts";

const root = path.resolve(import.meta.dirname, "../src/data/resume-examples");
const load = (dir: string) => readdirSync(path.join(root, dir)).filter((f) => f.endsWith(".json")).sort().map((f) => ({ file: f, data: JSON.parse(readFileSync(path.join(root, dir, f), "utf8")) }));
const samples = load("samples");
const guides = load("roles");
const countries = load("countries");
const only = process.argv.slice(2);

for (const s of samples) if (`${s.data.id}.json` !== s.file) console.log(`${s.file}: file name must be <id>.json`);
const data = samples.map((s) => s.data as Sample);
const issues = only.length
  ? [...data.filter((s) => only.includes(s.role)).flatMap(checkSample), ...duplicateIssues(data).filter((i) => only.some((r) => i.id.startsWith(`${r}-`)))]
  : checkAll(data, guides.map((g) => g.data), countries.map((c) => c.data));

// Static import index (bundlers and tests both understand plain imports).
const id = (f: string) => f.replace(/\.json$/, "").replace(/[^a-z0-9]/gi, "_");
const lines = ["// Generated by scripts/check-resume-examples.mts. Do not edit by hand.", 'import type { CountryRules, RoleGuide, Sample } from "@/lib/resume-examples/types";'];
for (const [dir, list] of [["samples", samples], ["roles", guides], ["countries", countries]] as const) for (const f of list) lines.push(`import ${dir}_${id(f.file)} from "./${dir}/${f.file}";`);
lines.push(`export const SAMPLES = [${samples.map((f) => `samples_${id(f.file)}`).join(", ")}] as Sample[];`);
lines.push(`export const GUIDES = [${guides.map((f) => `roles_${id(f.file)}`).join(", ")}] as RoleGuide[];`);
lines.push(`export const COUNTRY_RULES = [${countries.map((f) => `countries_${id(f.file)}`).join(", ")}] as CountryRules[];`);
writeFileSync(path.join(root, "index.ts"), lines.join("\n") + "\n");

console.log(`${samples.length} samples, ${guides.length} role guides, ${countries.length} country files`);
for (const i of issues) console.log(`✗ ${i.id}: ${i.problem}`);
console.log(issues.length ? `${issues.length} issue(s)` : "✓ all checks passed");
process.exitCode = issues.length ? 1 : 0;
