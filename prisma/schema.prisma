generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id               String               @id @default(cuid())
  email            String               @unique
  name             String?
  passwordHash     String
  isDemo           Boolean              @default(false)
  role             String               @default("user")
  emailVerifiedAt  DateTime?
  googleId         String?              @unique
  microsoftId      String?              @unique
  linkedinId       String?              @unique
  plan             String               @default("free")
  /// Pro is prepaid: it stays active until this date (then reverts to free)
  planRenewsAt     DateTime?
  /// Daily 7 AM "best new matches" email (Pro): opt-out flag and last send time
  digestOptOut     Boolean              @default(false)
  digestLastSentAt DateTime?
  /// Unused (was the Stripe customer id). Kept so the switch to Razorpay
  /// needs no destructive migration.
  legacyBillingRef String?              @unique @map("stripeCustomerId")
  createdAt        DateTime             @default(now())
  generations      Generation[]
  resetTokens      PasswordResetToken[]
  payments         Payment[]
  preferences      Preferences?
  profile          Profile?
  uploads          ResumeUpload[]
  resumeVersions   ResumeVersion[]
  savedSearches    SavedSearch[]
  sessions         Session[]
  tailorDrafts     TailorDraft[]
  usage            UsageEvent[]
  jobStates        UserJob[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use emailed tokens (password reset, email verification).
model PasswordResetToken {
  id        String    @id @default(cuid())
  purpose   String    @default("reset")
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  slug       String   @unique
  isPublic   Boolean  @default(false)
  /// JSON: ResumeData (see src/lib/resume/schema.ts)
  data       String
  /// JSON: Visibility (which sections / contact fields are public)
  visibility String
  resumeText String   @default("")
  parsedBy   String   @default("heuristic")
  theme      String   @default("aurora")
  views      Int      @default(0)
  /// JSON number[] - optional embedding of the profile (VOYAGE_API_KEY)
  embedding  String?
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Preferences {
  id        String   @id @default(cuid())
  userId    String   @unique
  /// JSON: JobPreferences
  data      String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Normalized listing as returned by a connected source. Never created
/// except from a source response (or a user-imported URL).
model Job {
  id              String        @id
  source          String
  externalId      String
  title           String
  company         String
  location        String        @default("")
  /// Detected from `location` (src/lib/geo/detect.ts): primary ISO country,
  /// all named countries (comma list), city, and remote eligibility scope.
  country         String?
  countries       String        @default("")
  city            String?
  remoteScope     String?
  workMode        String        @default("unknown")
  employmentType  String        @default("")
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String?
  salaryPeriod    String?
  /// Salary normalised to yearly USD (approximate FX) for filtering/insights
  salaryYearlyUsd Int?
  description     String
  url             String
  postedAt        DateTime?
  fetchedAt       DateTime      @default(now())
  firstSeenAt     DateTime      @default(now())
  /// Last time the source still returned this listing
  lastSeenAt      DateTime      @default(now())
  embedding       String?
  /// The user that imported this job via URL (null for feed listings)
  importedById    String?
  /// JSON (src/lib/jobs/enrich.ts): verified original posting, full
  /// description, AI-extracted requirements and market salary
  enrichment      String?
  enrichedAt      DateTime?
  /// Marked "no longer accepting applications" (by a user report or detected
  /// on the original posting). Hidden from the feed after the next daily refresh.
  expiredAt       DateTime?
  /// "auto" or the reporting user's id
  expiredBy       String?
  generations     Generation[]
  tailorDrafts    TailorDraft[]
  states          UserJob[]

  @@index([source, lastSeenAt])
  @@index([country, city])
}

model UserJob {
  id                 String    @id @default(cuid())
  userId             String
  jobId              String
  saved              Boolean   @default(false)
  hidden             Boolean   @default(false)
  status             String    @default("none")
  notes              String    @default("")
  appliedAt          DateTime?
  followUpAt         DateTime?
  followUpNotifiedAt DateTime?
  contactName        String    @default("")
  contactEmail       String    @default("")
  resumeVersionId    String?
  position           Int       @default(0)
  updatedAt          DateTime  @updatedAt
  job                Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Generation {
  id              String   @id @default(cuid())
  userId          String
  jobId           String?
  kind            String
  /// JSON payload of the generated result (encrypted at rest)
  content         String
  /// User-reviewed version (after accepting/rejecting changes)
  finalContent    String?
  resumeVersionId String?
  engine          String
  createdAt       DateTime @default(now())
  job             Job?     @relation(fields: [jobId], references: [id])
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Every résumé file a user uploads, kept exactly as uploaded (never overwritten).
model ResumeUpload {
  id          String   @id @default(cuid())
  userId      String
  fileName    String
  mimeType    String
  size        Int
  /// Original file bytes, base64 (encrypted at rest)
  data        String
  /// Text extracted from the file (encrypted at rest)
  text        String
  /// "text" (read directly) | "ocr" (scanned PDF read by AI; lower confidence)
  extractedBy String   @default("text")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// One tailored application (résumé + cover letter) for a job or a pasted job description.
model TailorDraft {
  id         String   @id @default(cuid())
  userId     String
  jobId      String?
  name       String
  country    String   @default("IN")
  templateId String   @default("in-corporate-ats")
  /// JSON TailorState: job text, analysis, selections, proposals, accepted résumé, letter, scores, history (encrypted at rest)
  state      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  job        Job?     @relation(fields: [jobId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model ResumeVersion {
  id        String   @id @default(cuid())
  userId    String
  name      String
  /// JSON ResumeData (encrypted at rest)
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedSearch {
  id          String   @id @default(cuid())
  userId      String
  name        String
  /// JSON SearchFilters
  filters     String
  frequency   String   @default("weekly")
  lastAlertAt DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One ingestion attempt per source - powers caching (TTL) and health.
model SourceRun {
  id         String   @id @default(cuid())
  source     String
  startedAt  DateTime @default(now())
  durationMs Int
  ok         Boolean
  count      Int
  error      String?

  @@index([source, startedAt])
}

/// Operator overrides for sources (secrets stay in env vars).
model SourceSetting {
  id           String   @id
  enabled      Boolean?
  /// comma-separated board tokens for employer feeds
  boards       String?
  /// Lifetime API requests made (for sources with a hard per-key quota, e.g. Jooble)
  requestsUsed Int      @default(0)
  updatedAt    DateTime @updatedAt
}

/// Metered AI actions for plan limits.
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Emails captured when no provider is configured (dev outbox).
model OutboxEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  html      String
  createdAt DateTime @default(now())
}

/// A Razorpay order for a prepaid Pro pass (UPI, cards, net banking, wallets).
model Payment {
  id        String    @id @default(cuid())
  userId    String
  orderId   String    @unique
  paymentId String?   @unique
  /// Amount in paise (INR x 100)
  amount    Int
  currency  String    @default("INR")
  period    String
  status    String    @default("created")
  /// upi | card | netbanking | wallet | emi ... as reported by Razorpay
  method    String?
  createdAt DateTime  @default(now())
  paidAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Interview questions from openly licensed collections (with attribution) and
/// questions users report they were asked (published after review).
model InterviewQuestion {
  id              String    @id
  source          String
  sourceUrl       String
  license         String
  attribution     String
  company         String?
  department      String
  roles           String
  experienceLevel String?
  questionType    String
  roundType       String?
  question        String
  answer          String?
  answerOrigin    String?
  tools           String
  skills          String
  /// Only for user reports: when the user was asked this.
  dateAsked       DateTime?
  /// Last change to the source file (collections) or the report date (users).
  sourceUpdatedAt DateTime?
  hash            String
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  status          String    @default("published")
  submittedById   String?

  @@index([status, department])
  @@index([source, lastSeenAt])
}
