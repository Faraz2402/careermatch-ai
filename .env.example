# --- Core -------------------------------------------------------------
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"

# --- AI (optional) ----------------------------------------------------
# Without a key the app still works: resume parsing uses a heuristic parser
# and generated documents use transparent templates (labelled as such).
ANTHROPIC_API_KEY=""
# Free alternative: Google AI Studio key (https://aistudio.google.com/apikey).
# Used when ANTHROPIC_API_KEY is empty. GEMINI_MODEL is optional.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
# Tried in order when the main model hits its daily free-tier limit.
GEMINI_FALLBACK_MODELS="gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.6-flash"
# Google Search grounding (finding original postings and market pay).
# The free tier allows about 20 searches a day; enable billing for more.
GEMINI_SEARCH_MODEL="gemini-2.5-flash"

# --- Job sources ------------------------------------------------------
# Public, documented APIs that need no key (on by default):
#   remotive, arbeitnow. Demo data is on only outside production.
JOB_SOURCES_ENABLED="demo,remotive,arbeitnow,remoteok,weworkremotely,jobicy,himalayas,workingnomads,realworkfromanywhere,greenhouse,lever,ashby,smartrecruiters,workable,successfactors,oracle,adzuna,jooble"

# Employer career boards (official public job-board APIs), comma-separated
# board tokens / company handles, e.g. "stripe,figma"
GREENHOUSE_BOARDS=""
LEVER_COMPANIES=""
ASHBY_BOARDS=""
# SmartRecruiters company identifiers, Workable account names,
# SuccessFactors career-site hosts (host=Company) and Oracle sites (host/SITE=Company).
# Admin -> Sources overrides these. EMPLOYER_BOARD_COUNTRIES limits them (default IN).
SMARTRECRUITERS_COMPANIES=""
WORKABLE_ACCOUNTS=""
SUCCESSFACTORS_SITES=""
ORACLE_SITES=""
EMPLOYER_BOARD_COUNTRIES="IN"

# Adzuna (https://developer.adzuna.com) – free key required
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
# Countries to ingest (ISO codes). Supported: in,us,gb,ca,au,nz,sg,za,br,mx,de,fr,nl,at,be,es,it,ch,pl
ADZUNA_COUNTRIES="in"


# Jooble (https://in.jooble.org/api/about) - free key. A country-site key covers
# only that country; a key from the global site works with JOOBLE_HOST="jooble.org"
# and can serve several countries listed in JOOBLE_COUNTRY (e.g. "in,us").
# Free plan = 500 requests per key, lifetime. The app stops at JOOBLE_MAX_REQUESTS.
JOOBLE_API_KEY=""
JOOBLE_COUNTRY="in"
JOOBLE_HOST=""
JOOBLE_MAX_REQUESTS="450"


# Set to "false" to hide the demo listings even in development
DEMO_JOBS="true"

# --- Security ---------------------------------------------------------
# 32-byte key (base64) for encrypting resume data at rest. REQUIRED in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=""
# Comma-separated emails that get the Admin console (/admin)
ADMIN_EMAILS=""
# Protects /api/cron/* (send as "Authorization: Bearer <secret>")
CRON_SECRET=""
# Set to "false" on serverless hosts and call /api/cron/{refresh,alerts,cleanup} instead
BACKGROUND_JOBS="true"

# --- Email (alerts, verification, password reset) ---------------------
# Without these, emails go to the dev outbox at /dev/outbox
RESEND_API_KEY=""
EMAIL_FROM="CareerMatch AI <hello@yourdomain.com>"

# --- Social sign-in (optional; each button appears once its pair is set) ---
# Redirect URI to register with each: $APP_URL/api/auth/oauth/<google|microsoft|linkedin>/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Microsoft Entra app, "personal Microsoft accounts and any organisation"
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# LinkedIn app with the "Sign In with LinkedIn using OpenID Connect" product
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# --- Payments (optional, Razorpay - India) ---------------------------
# UPI (Google Pay, PhonePe, Paytm, BHIM...), debit/credit cards (Visa,
# Mastercard, RuPay, Amex, Diners), net banking and wallets.
# Keys: dashboard.razorpay.com -> Account & Settings -> API Keys
# (test keys rzp_test_... work immediately; live keys need KYC).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook URL: $APP_URL/api/billing/webhook, events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=""
# Pro pass prices in whole rupees
PRO_MONTHLY_INR="499"
PRO_YEARLY_INR="4999"

# --- Semantic matching (optional) -------------------------------------
VOYAGE_API_KEY=""
VOYAGE_MODEL="voyage-3.5-lite"

# --- Multi-instance rate limiting (optional, Upstash Redis REST) -------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Error reporting (optional) ---------------------------------------
# Any webhook that accepts {"text": "..."} JSON (Slack, Discord, etc.)
ERROR_WEBHOOK_URL=""

# Free web search fallback (1,000 searches/month, no card): https://app.tavily.com
TAVILY_API_KEY=""

# --- Legal pages (/privacy, /terms) ------------------------------------
# Shown as the operator, Grievance Officer and courts (IT Rules 2021 r.3(2),
# Consumer Protection (E-Commerce) Rules 2020 r.4, DPDP Act 2023).
LEGAL_OPERATOR=""
LEGAL_EMAIL=""
GRIEVANCE_OFFICER_NAME=""
GRIEVANCE_EMAIL=""
LEGAL_JURISDICTION=""   # city whose courts handle disputes, e.g. "Bengaluru, Karnataka"
